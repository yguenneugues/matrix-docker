# Configuration initiale pour obtenir le certificat Let's Encrypt
# HTTP uniquement - pas de SSL

server {
    listen 80;
    listen [::]:80;
    server_name matrix.tchap.csm.ovh;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 200 'Matrix server - waiting for SSL certificate';
        add_header Content-Type text/plain;
    }
}