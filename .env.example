# ===========================================
# Configuration Matrix Synapse Docker
# Copiez ce fichier vers .env et modifiez les valeurs
# ===========================================

# -----------------
# Domaine et réseau
# -----------------
MATRIX_DOMAIN=matrix.example.com
SERVER_NAME=example.com
ADMIN_EMAIL=admin@example.com

# -----------------
# PostgreSQL
# -----------------
POSTGRES_DB=synapse
POSTGRES_USER=synapse
# Générer avec: openssl rand -hex 32
POSTGRES_PASSWORD=

# -----------------
# Synapse
# -----------------
SYNAPSE_REPORT_STATS=no
# Générer avec: openssl rand -hex 32
SYNAPSE_REGISTRATION_SHARED_SECRET=
# Générer avec: openssl rand -hex 32
SYNAPSE_MACAROON_SECRET_KEY=

# -----------------
# Keycloak OpenID Connect
# -----------------
OIDC_ENABLED=true
# URL de votre realm Keycloak
OIDC_ISSUER=https://keycloak.example.com/realms/your-realm
OIDC_CLIENT_ID=synapse
# Secret du client Keycloak
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Keycloak
# Template pour générer le nom d'utilisateur local
OIDC_USER_MAPPING_PROVIDER_CONFIG_LOCALPART_TEMPLATE={{ user.preferred_username }}
OIDC_USER_MAPPING_PROVIDER_CONFIG_DISPLAY_NAME_TEMPLATE={{ user.name }}

# -----------------
# Let's Encrypt / Certbot
# -----------------
LETSENCRYPT_EMAIL=admin@example.com
# Mettre à true pour tester sans dépasser les limites Let's Encrypt
CERTBOT_STAGING=false
